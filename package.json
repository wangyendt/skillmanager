{
  "name": "skilltruck",
  "version": "0.2.2",
  "description": "Ship, install, update, and synchronize Agent Skills across coding agents.",
  "keywords": [
    "skilltruck",
    "skill-distribution",
    "openskills",
    "claude",
    "cursor",
    "skills",
    "agent"
  ],
  "homepage": "https://github.com/wangyendt/skilltruck#readme",
  "bugs": {
    "url": "https://github.com/wangyendt/skilltruck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyendt/skilltruck.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "wang121ye",
  "type": "commonjs",
  "bin": {
    "skilltruck": "src/cli.js"
  },
  "main": "src/index.js",
  "files": [
    "src/",
    "manifests/",
    "skills/"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "postinstall": "node src/postinstall.js",
    "test": "node --test",
    "agents:check": "node scripts/sync-supported-agents.js --check",
    "agents:sync": "node scripts/sync-supported-agents.js --write",
    "pack:check": "node scripts/pack-check.js",
    "smoke:install": "node scripts/install-smoke.js",
    "verify": "npm run agents:check && npm test && npm run pack:check && npm run smoke:install",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "express": "^4.21.2",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "openskills": "^1.5.0",
    "simple-git": "^3.27.0",
    "undici": "^6.23.0",
    "yoctocolors-cjs": "^2.1.3"
  }
}
